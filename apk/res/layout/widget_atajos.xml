<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de atajos: tus gastos frecuentes en un toque -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_fondo" android:gravity="center_vertical"
    android:orientation="horizontal" android:padding="8dp">

    <TextView android:id="@+id/a_vacio" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:paddingStart="6dp" android:text="Registra gastos y aquí salen tus favoritos" android:textColor="#DDFFFFFF" android:textSize="12sp" />
    <TextView android:id="@+id/a1" style="@style/FinanzasAtajo" />
    <TextView android:id="@+id/a2" style="@style/FinanzasAtajo" />
    <TextView android:id="@+id/a3" style="@style/FinanzasAtajo" />
    <TextView android:id="@+id/a4" style="@style/FinanzasAtajo" />
    <TextView android:id="@+id/a_mas" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="4dp"
        android:background="@drawable/widget_boton" android:gravity="center" android:text="+" android:textColor="#04120C"
        android:textSize="26sp" android:textStyle="bold" android:contentDescription="Registrar gasto" />
</LinearLayout>
